Cell[BoxData[{
 RowBox[{
  RowBox[{"ETMtot", "[", 
   RowBox[{
   "m_", ",", "n_", ",", "x_", ",", "y_", ",", "\[Omega]_", ",", "a_", ",", 
    "\[Epsilon]_", ",", "\[Mu]_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"EperpTM3D", "[", 
    RowBox[{
    "m", ",", "n", ",", "x", ",", "y", ",", "\[Omega]", ",", "a", ",", 
     "\[Epsilon]", ",", "\[Mu]"}], "]"}], "+", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", 
     RowBox[{"TM", "[", 
      RowBox[{"a", ",", "m", ",", "n", ",", "x", ",", "y"}], "]"}]}], 
    "}"}]}]}], "\n", 
 RowBox[{
  RowBox[{"ETMtotProp", "[", 
   RowBox[{
   "m_", ",", "n_", ",", "x_", ",", "y_", ",", "\[Omega]_", ",", "a_", ",", 
    "\[Epsilon]_", ",", "\[Mu]_", ",", "z_", ",", "t_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"EperpTM3D", "[", 
     RowBox[{
     "m", ",", "n", ",", "x", ",", "y", ",", "\[Omega]", ",", "a", ",", 
      "\[Epsilon]", ",", "\[Mu]"}], "]"}], "*", 
    RowBox[{"(", 
     RowBox[{"I", " ", 
      RowBox[{"Sin", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"KTM", "[", 
          RowBox[{
          "m", ",", "n", ",", "\[Omega]", ",", "\[Epsilon]", ",", "\[Mu]", 
           ",", "a"}], "]"}], "z"}], "-", 
        RowBox[{"\[Omega]", " ", "t"}]}], "]"}]}], ")"}]}], "+", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", 
      RowBox[{"TM", "[", 
       RowBox[{"a", ",", "m", ",", "n", ",", "x", ",", "y"}], "]"}]}], "}"}], 
    "*", 
    RowBox[{"Cos", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"KTM", "[", 
        RowBox[{
        "m", ",", "n", ",", "\[Omega]", ",", "\[Epsilon]", ",", "\[Mu]", ",", 
         "a"}], "]"}], "z"}], "-", 
      RowBox[{"\[Omega]", " ", "t"}]}], "]"}]}]}]}]}], "Input",
