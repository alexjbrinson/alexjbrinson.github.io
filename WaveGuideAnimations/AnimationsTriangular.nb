Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Defining", " ", "functions", " ", "to", " ", "Compute", " ", "the", " ", 
    "perpendicular", " ", "components", " ", "of", " ", "the", " ", 
    "solutions"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"WcutTM", "[", 
      RowBox[{"m_", ",", "n_", ",", "\[Epsilon]_", ",", "\[Mu]_", ",", "a_"}],
       "]"}], ":=", 
     RowBox[{
      FractionBox["1", 
       SqrtBox[
        RowBox[{"\[Epsilon]", " ", "\[Mu]"}]]], 
      FractionBox["\[Pi]", "a"], 
      SqrtBox[
       RowBox[{
        SuperscriptBox["m", "2"], "+", " ", 
        SuperscriptBox["n", "2"]}]]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"KTM", "[", 
      RowBox[{
