Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox[
    RowBox[{"\[ImaginaryI]", " ", "a", " ", 
     SqrtBox[
      RowBox[{
       RowBox[{"\[Epsilon]0", " ", "\[Mu]0"}], "-", 
       FractionBox[
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["m", "2"], "+", 
