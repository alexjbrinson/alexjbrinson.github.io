Cell[BoxData[{
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    OverscriptBox["E", "\[RightVector]"], 
    RowBox[{"\[Perpendicular]", 
     RowBox[{",", 
      RowBox[{"(", 
       RowBox[{"m", ",", "n"}], ")"}]}]}], "TM"], "=", 
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"i", " ", 
       RowBox[{
        SubsuperscriptBox["k", 
         RowBox[{"m", ",", "n"}], "TM"], "(", "\[Omega]", ")"}]}], 
      SubsuperscriptBox["\[Gamma]", 
       RowBox[{"m", ",", "n"}], "2"]], " ", 
     RowBox[{
      SubscriptBox[
       OverscriptBox["\[Del]", "\[RightVector]"], "\[Perpendicular]"], 
      SubsuperscriptBox[
       OverscriptBox["E", "\[RightVector]"], 
       RowBox[{"0", ",", " ", "Z", ",", 
        RowBox[{"(", 
         RowBox[{"m", ",", "n"}], ")"}]}], "TM"]}]}], " ", "=", " ", 
    RowBox[{
     FractionBox[
      RowBox[{"\[ImaginaryI]", " ", "a"}], 
      RowBox[{"\[Pi]", " ", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["m", "2"], "+", 
         SuperscriptBox["n", "2"]}], ")"}]}]], 
     FractionBox["\[Omega]", "c"], 
     SqrtBox[
      RowBox[{"1", "-", 
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["m", "2"], "+", 
            SuperscriptBox["n", "2"]}], ")"}], " ", 
          SuperscriptBox["\[Pi]", "2"]}], 
         RowBox[{" ", 
          SuperscriptBox["a", "2"], " "}]], 
        FractionBox[
         SuperscriptBox["c", "2"], 
         SuperscriptBox["\[Omega]", "2"]]}]}]], " ", 
     RowBox[{"{", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"[", 
         RowBox[{
          RowBox[{"m", " ", 
           RowBox[{"Cos", "(", 
            FractionBox[
             RowBox[{"m", " ", "\[Pi]", " ", "x"}], "a"], ")"}], " ", 
           RowBox[{"Sin", "(", 
            FractionBox[
             RowBox[{"n", " ", "\[Pi]", " ", "y"}], "a"], ")"}]}], " ", "-", 
          RowBox[{"n", " ", 
           RowBox[{"Cos", "(", 
            FractionBox[
             RowBox[{"n", " ", "\[Pi]", " ", "x"}], "a"], ")"}], " ", 
           RowBox[{"Sin", "(", 
            FractionBox[
             RowBox[{"m", " ", "\[Pi]", " ", "y"}], "a"], ")"}]}]}], "]"}], 
        " ", 
        OverscriptBox["x", "^"]}], " ", "+", " ", 
       RowBox[{
        RowBox[{"[", 
         RowBox[{
          RowBox[{"m", " ", 
           RowBox[{"Cos", "(", 
            FractionBox[
             RowBox[{"m", " ", "\[Pi]", " ", "y"}], "a"], ")"}], " ", 
           RowBox[{"Sin", "(", 
            FractionBox[
             RowBox[{"n", " ", "\[Pi]", " ", "x"}], "a"], ")"}]}], "-", 
          RowBox[{"n", " ", 
           RowBox[{"Cos", "(", 
            FractionBox[
             RowBox[{"n", " ", "\[Pi]", " ", "y"}], "a"], ")"}], " ", 
           RowBox[{"Sin", "(", 
            FractionBox[
             RowBox[{"m", " ", "\[Pi]", " ", "x"}], "a"], ")"}]}]}], " ", 
         "]"}], "  ", 
        OverscriptBox["y", "^"]}]}], " ", "}"}]}]}]}], 
  TraditionalForm], "\[IndentingNewLine]", 
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    OverscriptBox["H", "\[RightVector]"], 
    RowBox[{"\[Perpendicular]", 
     RowBox[{",", 
      RowBox[{"(", 
       RowBox[{"m", ",", "n"}], ")"}]}]}], "TM"], "=", 
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"i", " "}], 
      SubsuperscriptBox["\[Gamma]", 
       RowBox[{"m", ",", "n"}], "2"]], 
     FractionBox[
      SubscriptBox["k", 
       RowBox[{"\[Epsilon]", ",", "\[Mu]"}]], 
      SubscriptBox["Z", 
       RowBox[{"\[Epsilon]", ",", "\[Mu]"}]]], " ", 
     RowBox[{
      OverscriptBox["z", "^"], " ", "\[Cross]", " ", 
      RowBox[{
       SubscriptBox[
        OverscriptBox["\[Del]", "\[RightVector]"], "\[Perpendicular]"], 
