Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"some", " ", "relevant", " ", "equations"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Hperp", "=", 
     RowBox[{
      FractionBox["1", 
       RowBox[{
        SuperscriptBox["Keu", "2"], "-", 
        SuperscriptBox["k", "2"]}]], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"I", " ", "k", " ", 
         RowBox[{"Grad", "[", 
          RowBox[{"H0z", ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], "+", 
        RowBox[{"I", " ", 
         FractionBox["Keu", "Zeu"], " ", 
         RowBox[{"Cross", "[", 
          RowBox[{"zHat", ",", " ", 
           RowBox[{"Grad", "[", 
            RowBox[{"E0z", ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], "]"}]}]}], ")"}]}]}],
     ";"}], "  ", 
   RowBox[{"(*", 
    RowBox[{"eq", " ", "9.261"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Eperp", "=", 
     RowBox[{
      FractionBox["1", 
       RowBox[{
        SuperscriptBox["Keu", "2"], "-", 
        SuperscriptBox["k", "2"]}]], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"I", " ", "k", " ", 
         RowBox[{"Grad", "[", 
          RowBox[{"E0z", ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], "-", 
        RowBox[{"I", " ", "Keu", " ", "*", "Zeu", " ", 
         RowBox[{"Cross", "[", 
          RowBox[{"zHat", ",", " ", 
           RowBox[{"Grad", "[", 
            RowBox[{"H0z", ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], "]"}]}]}], ")"}]}]}],
     ";"}], "  ", 
   RowBox[{"(*", 
    RowBox[{"eq", " ", "9.262"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Laplacian", "[", 
        RowBox[{"E0z", ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "y"}], "}"}]}], "]"}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["Keu", "2"], "-", 
          SuperscriptBox["k", "2"]}], ")"}], "E0z"}]}], " ", "=", " ", "0"}], 
     " ", ";", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Laplacian", "[", 
        RowBox[{"H0z", ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "y"}], "}"}]}], "]"}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["Keu", "2"], "-", 
          SuperscriptBox["k", "2"]}], ")"}], "H0z"}]}], " ", "=", " ", 
      "0"}]}], " ", 
    RowBox[{"(*", 
     RowBox[{"eq", " ", "9.266"}], "*)"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        SuperscriptBox[
         SubscriptBox["\[Del]", "\[Perpendicular]"], "2"], 
        SubscriptBox["E", 
         RowBox[{"0", ",", "z"}]]}], "+", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox[
           SubscriptBox["k", "\[Epsilon]\[Mu]"], "2"], "-", " ", 
          SuperscriptBox["k", "2"]}], ")"}], 
        SubscriptBox["E", 
         RowBox[{"0", ",", "z"}]]}]}], " ", "=", " ", "0"}], " ", ";", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        SuperscriptBox[
         SubscriptBox["\[Del]", "\[Perpendicular]"], "2"], 
        SubscriptBox["H", 
         RowBox[{"0", ",", "z"}]]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox[
           SubscriptBox["k", "\[Epsilon]\[Mu]"], "2"], "-", " ", 
          SuperscriptBox["k", "2"]}], ")"}], 
        SubscriptBox["H", 
         RowBox[{"0", ",", "z"}]]}]}], " ", "=", " ", "0"}]}], " ", 
    RowBox[{"(*", "9.266", "*)"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"TE", ":", " ", "Hperp"}], " ", "=", " ", 
       RowBox[{
        FractionBox["1", "Zeu"], 
        FractionBox["k", "Keu"], " ", 
        RowBox[{"Cross", "[", 
         RowBox[{"zHat", ",", " ", "E0perp", ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}]}], "]"}], " ", ";", " ", 
     RowBox[{
      RowBox[{"TM", ":", " ", "Hperp"}], " ", "=", " ", 
      RowBox[{
       FractionBox["1", "Zeu"], 
       FractionBox["Keu", "k"], " ", 
       RowBox[{"Cross", "[", 
        RowBox[{"zHat", ",", " ", "E0perp"}], "]"}]}]}]}], " ", 
    RowBox[{"(*", 
     RowBox[{"eq", " ", "9.267"}], "*)"}], "*)"}], "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Boundary", " ", 
       RowBox[{"Conditions", ":", " ", 
        RowBox[{
         OverscriptBox["n", "^"], "\[CenterDot]", 
         OverscriptBox["H", "\[RightVector]"]}]}]}], " ", "=", " ", "0"}], 
     ";", " ", 
     RowBox[{
      RowBox[{
       OverscriptBox["t", "^"], "\[CenterDot]", 
       OverscriptBox["E", "\[RightVector]"]}], " ", "=", " ", "0"}], " ", ";",
      "   ", 
     RowBox[{
      RowBox[{
       SubscriptBox["E", 
        RowBox[{"0", ",", "z"}]], 
       SubscriptBox["|", "C"]}], " ", "=", " ", "0"}], " ", 
     RowBox[{"(*", "9.268", "*)"}], "  ", ";", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{
        OverscriptBox["n", "^"], "\[CenterDot]", 
        RowBox[{
         SubscriptBox[
          OverscriptBox["\[Del]", "\[RightVector]"], "\[Perpendicular]"], 
         SubscriptBox["H", 
          RowBox[{"0", ",", "z"}]]}]}], 
       SubscriptBox["|", "C"]}], " ", "=", " ", "0"}]}], "  ", 
    RowBox[{"(*", "9.269", "*)"}], "*)"}]}]}]], "Input",
 Evaluatable->False,
