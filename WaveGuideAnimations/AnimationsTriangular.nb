Cell[BoxData[
 RowBox[{
  RowBox[{"assumptions", " ", "=", " ", 
   RowBox[{
    RowBox[{"a", "\[Element]", "Reals"}], "&&", 
    RowBox[{"x", "\[Element]", "Reals"}], "&&", 
    RowBox[{"m", "\[Element]", "Integers"}], "&&", 
    RowBox[{"n", "\[Element]", "Integers"}], "&&", 
