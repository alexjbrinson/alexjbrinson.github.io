         SuperscriptBox["a", "2"], " ", 
         SuperscriptBox["\[Omega]", "2"]}]]}]], " ", "\[Omega]", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "n"}], " ", 
