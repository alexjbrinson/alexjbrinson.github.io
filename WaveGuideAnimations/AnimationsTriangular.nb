            FractionBox[
             RowBox[{"m", " ", "\[Pi]", " ", "x"}], "a"], ")"}]}]}], "]"}], 
        " ", 
        OverscriptBox["x", "^"]}], " ", "+", " ", 
       RowBox[{
        RowBox[{"[", 
