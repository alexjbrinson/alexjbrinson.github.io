Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"You", " ", "can", " ", "also", " ", "ignore", " ", "this", " ", 
     RowBox[{"cell", ".", " ", "Same"}], " ", "deal", " ", "as", " ", 
     "before"}], ";", " ", 
    RowBox[{
     RowBox[{
     "I", " ", "just", " ", "wanted", " ", "to", " ", "show", " ", "that", 
      " ", 
      SubsuperscriptBox["\[Psi]", 
       RowBox[{"2", ",", "1"}], "TM"]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"-", 
       SubsuperscriptBox["\[Psi]", 
        RowBox[{"1", ",", "2"}], "TM"]}], " ", "are", " ", "both", " ", 
      "really", " ", "the", " ", "same", " ", 
      RowBox[{"solution", "."}]}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"minVal", " ", "=", 
    RowBox[{
     RowBox[{"FindMinimum", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"TM", "[", 
          RowBox[{"1", ",", "2", ",", "1", ",", "x", ",", "y"}], "]"}], ",", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", "y"}], "}"}], "\[Element]", "guideReg"}]}], 
        "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", ".1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"y", ",", ".1"}], "}"}]}], "}"}]}], "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"maxVal", "=", 
    RowBox[{
     RowBox[{"FindMaximum", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"TM", "[", 
          RowBox[{"1", ",", "2", ",", "1", ",", "x", ",", "y"}], "]"}], ",", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", "y"}], "}"}], "\[Element]", "guideReg"}]}], 
        "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", ".1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"y", ",", ".1"}], "}"}]}], "}"}]}], "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], "\n", 
   RowBox[{"DensityPlot", "[", 
    RowBox[{
     FractionBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"TM", "[", 
         RowBox[{"1", ",", "2", ",", "1", ",", "x", ",", "y"}], "]"}], "-", 
        "minVal"}], ")"}], 
      RowBox[{"2", " ", 
       RowBox[{"Abs", "[", 
        RowBox[{"maxVal", "-", "minVal"}], "]"}]}]], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "y"}], "}"}], "\[Element]", "guideReg"}], ",", 
     RowBox[{"ColorFunction", "\[Rule]", "\"\<TemperatureMap\>\""}], ",", 
     RowBox[{"ColorFunctionScaling", "\[Rule]", "False"}], ",", 
     RowBox[{"PlotPoints", "\[Rule]", "30"}], ",", 
     RowBox[{
     "PlotLabel", "\[Rule]", 
      "\"\<\!\(\*SubsuperscriptBox[\(\[Psi]\), \(2, 1\), \
\(TM\)]\)(x,y)\>\""}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.736283491539398*^9, 3.73628349278068*^9}, 
