Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "You", " ", "can", " ", "probably", " ", "ignore", " ", "this", " ", 
    RowBox[{"cell", ".", " ", "I"}], " ", "was", " ", "just", " ", "being", 
    " ", "stubborn", " ", "and", " ", "wanted", " ", "the", " ", "zero", " ", 
    "point", " ", "on", " ", "my", " ", "colorbar", " ", "to", " ", 
    "correspond", " ", "with", " ", "white"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"minVal", " ", "=", 
    RowBox[{
     RowBox[{"FindMinimum", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"TM", "[", 
          RowBox[{"1", ",", "1", ",", "2", ",", "x", ",", "y"}], "]"}], ",", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", "y"}], "}"}], "\[Element]", "guideReg"}]}], 
        "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", ".1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"y", ",", ".1"}], "}"}]}], "}"}]}], "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"maxVal", "=", 
    RowBox[{
     RowBox[{"FindMaximum", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"TM", "[", 
          RowBox[{"1", ",", "1", ",", "2", ",", "x", ",", "y"}], "]"}], ",", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", "y"}], "}"}], "\[Element]", "guideReg"}]}], 
        "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", ".1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"y", ",", ".1"}], "}"}]}], "}"}]}], "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], "\n", 
   RowBox[{"DensityPlot", "[", 
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"TM", "[", 
          RowBox[{"1", ",", "1", ",", "2", ",", "x", ",", "y"}], "]"}], "-", 
         "minVal"}], ")"}], 
       RowBox[{"2", " ", 
        RowBox[{"Abs", "[", 
         RowBox[{"maxVal", "-", "minVal"}], "]"}]}]], "+", ".5"}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "y"}], "}"}], "\[Element]", "guideReg"}], ",", 
     RowBox[{"ColorFunction", "\[Rule]", "\"\<TemperatureMap\>\""}], ",", 
     RowBox[{"ColorFunctionScaling", "\[Rule]", "False"}], ",", 
     RowBox[{"PlotPoints", "\[Rule]", "30"}], ",", 
     RowBox[{
     "PlotLabel", "\[Rule]", 
      "\"\<\!\(\*SubsuperscriptBox[\(\[Psi]\), \(1, 2\), \
\(TM\)]\)(x,y)\>\""}]}], "]"}]}]}]], "Input",
