Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"min52", " ", "=", 
  RowBox[{
   RowBox[{"FindMinimum", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"TM", "[", 
        RowBox[{"1", ",", "5", ",", "2", ",", "x", ",", "y"}], "]"}], ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "y"}], "}"}], "\[Element]", "guideReg"}]}], "}"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", ".1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", ".1"}], "}"}]}], "}"}]}], "]"}], "[", 
   RowBox[{"[", "1", "]"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"max52", "=", 
  RowBox[{
   RowBox[{"FindMaximum", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"TM", "[", 
        RowBox[{"1", ",", "5", ",", "2", ",", "x", ",", "y"}], "]"}], ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "y"}], "}"}], "\[Element]", "guideReg"}]}], "}"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", ".9"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", ".1"}], "}"}]}], "}"}]}], "]"}], "[", 
   RowBox[{"[", "1", "]"}], "]"}]}], "\n", 
 RowBox[{"DensityPlot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"TM", "[", 
     RowBox[{"1", ",", "5", ",", "2", ",", "x", ",", "y"}], "]"}], "*", 
    RowBox[{"HeavisideTheta", "[", 
     RowBox[{"x", "-", "y"}], "]"}]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", ",", "y"}], "}"}], "\[Element]", "guideReg"}], ",", 
   RowBox[{"ColorFunction", "\[Rule]", "\"\<TemperatureMap\>\""}], ",", 
   RowBox[{"PlotPoints", "\[Rule]", "30"}], ",", 
   RowBox[{"PlotLegends", "\[Rule]", 
    RowBox[{"BarLegend", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<TemperatureMap\>\"", ",", 
       RowBox[{"{", 
        RowBox[{"min52", ",", 
         RowBox[{"-", "min52"}]}], "}"}]}], "}"}], "]"}]}], ",", 
   RowBox[{
   "PlotLabel", "\[Rule]", 
    "\"\<\!\(\*SubsuperscriptBox[\(\[Psi]\), \(5, 2\), \
\(TM\)]\)(x,y)\>\""}]}], "]"}]}], "Input",
